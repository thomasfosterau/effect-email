{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // Resolve the package names to the EMITTED declarations rather than the
    // workspace `exports` (which point at `src/` for the in-repo dev loop) —
    // which is also why this package declares no dependency on any of them:
    // the mapping below is the whole resolution. Relative to this file;
    // TypeScript 7 removed `baseUrl`.
    "paths": {
      "@thomasfosterau/effect-connect": ["../../packages/core/dist/index.d.ts"],
      "@thomasfosterau/effect-connect-sendgrid": ["../../packages/sendgrid/dist/index.d.ts"],
      "@thomasfosterau/effect-connect-resend": ["../../packages/resend/dist/index.d.ts"],
      "@thomasfosterau/effect-connect-twilio": ["../../packages/twilio/dist/index.d.ts"],
      "@thomasfosterau/effect-connect-vonage": ["../../packages/vonage/dist/index.d.ts"],
      "@thomasfosterau/effect-connect-slack": ["../../packages/slack/dist/index.d.ts"],
      "@thomasfosterau/effect-connect-discord": ["../../packages/discord/dist/index.d.ts"],
      "@thomasfosterau/effect-connect-alchemy": ["../../packages/alchemy/dist/index.d.ts"]
    }
  },
  "include": ["src"]
}
