{
  "name": "@thomasfosterau/effect-connect-alchemy-cloudflare",
  "version": "0.1.0",
  "description": "Alchemy Cloudflare deploy-time bindings for @thomasfosterau/effect-connect: per-provider builders whose keys match each provider's Worker env contract, with secrets as Redacted values, so a Cloudflare Worker deployed with Alchemy's Cloudflare provider gets exactly the bindings resolveTransport(env) reads, typed by the provider's own InferEnv.",
  "keywords": [
    "alchemy",
    "cloudflare",
    "effect",
    "email",
    "sms",
    "typescript",
    "workers"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-connect#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-connect/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-connect.git",
    "directory": "packages/alchemy-cloudflare"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "@thomasfosterau/effect-connect-resend": "workspace:^",
    "@types/node": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "@alchemy.run/cloudflare": "catalog:alchemy-peers",
    "alchemy": "catalog:alchemy-peers",
    "effect": "catalog:alchemy-peers"
  },
  "engines": {
    "node": ">=22"
  }
}
