{
  "name": "@thomasfosterau/effect-email",
  "version": "0.0.0",
  "description": "An Effect-native email abstraction: message schemas, the EmailService contract and its errors, provider-agnostic — SendGrid and Resend providers ship as sibling packages.",
  "keywords": [
    "effect",
    "email",
    "transactional",
    "typescript"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-email#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-email/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-email.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "engines": {
    "node": ">=22"
  }
}
