{
  "name": "@thomasfosterau/effect-connect-alchemy",
  "version": "0.0.0",
  "description": "Alchemy deploy-time bindings for @thomasfosterau/effect-connect: per-provider builders whose keys match each provider's Worker env contract, with secrets as Redacted values, so a Cloudflare Worker deployed by Alchemy gets exactly the bindings resolveTransport(env) reads.",
  "keywords": [
    "alchemy",
    "cloudflare",
    "effect",
    "email",
    "sms",
    "typescript",
    "workers"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-connect#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-connect/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-connect.git",
    "directory": "packages/alchemy"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@effect/language-service": "catalog:",
    "@thomasfosterau/effect-connect-discord": "workspace:^",
    "@thomasfosterau/effect-connect-resend": "workspace:^",
    "@thomasfosterau/effect-connect-sendgrid": "workspace:^",
    "@thomasfosterau/effect-connect-slack": "workspace:^",
    "@thomasfosterau/effect-connect-twilio": "workspace:^",
    "@thomasfosterau/effect-connect-vonage": "workspace:^",
    "@types/node": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "peerDependenciesMeta": {
    "alchemy": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
