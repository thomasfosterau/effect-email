{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    // Copied from the preferenceflow application so the library compiles under
    // exactly the options its consumers use. `erasableSyntaxOnly` because the
    // apps load TypeScript under Node's strip-only loader; a library file that
    // uses enums / namespaces / parameter properties would fail there.
    "erasableSyntaxOnly": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    // Source imports are written `./x.ts`; this flag lets them type-check.
    // `vp pack` (tsdown) bundles each entry point into one `index.js` +
    // `index.d.ts`, so no relative specifier reaches a consumer.
    "rewriteRelativeImportExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        // The severities below keep every Effect rule visible in the editor,
        // but a "warning" still fails the patched tsc by default — this flag
        // is what actually makes warnings non-blocking in the check tasks.
        "ignoreEffectWarningsInTscExitCode": true,
        "diagnosticSeverity": {
          "abortControllerInEffect": "warning",
          "asyncFunction": "warning",
          "cryptoRandomUUID": "warning",
          "cryptoRandomUUIDInEffect": "warning",
          "extendsNativeError": "warning",
          "globalConsole": "warning",
          "globalConsoleInEffect": "warning",
          "globalDate": "warning",
          "globalDateInEffect": "warning",
          "globalFetch": "warning",
          "globalFetchInEffect": "warning",
          "globalRandom": "warning",
          "globalRandomInEffect": "warning",
          "globalTimers": "warning",
          "globalTimersInEffect": "warning",
          "instanceOfSchema": "warning",
          "newPromise": "warning",
          "nodeBuiltinImport": "warning",
          "preferSchemaOverJson": "warning",
          "processEnv": "warning",
          "processEnvInEffect": "warning",
          "unsafeEffectTypeAssertion": "warning",
          // Effect 4 marks much of `effect/http` `@stability unstable`, so as a
          // warning this fires on every provider's HTTP import and drowns the
          // warnings that matter. Owner decision (#36): a suggestion.
          "unstableApiUsage": "suggestion"
        }
      }
    ]
  }
}
