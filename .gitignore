.DS_Store
node_modules
.env
.env.*
!.env.example
.tmp
.tools
.fallow
fallow.sarif
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock
.pnpm-store
vite.config.*.timestamp*
*.log

# TypeScript incremental build cache. Regenerated; never committed.
*.tsbuildinfo

# Built package output (`vp run -r build`); published to npm, never committed.
dist/
# Generated API docs and example files (`vp run -r docgen`); never committed.
packages/*/docs/
# Tarballs `scripts/release.sh` packs before `npm publish`.
.release/

# The Vite+ task cache and vitest scratch dirs.
.vite/
# The generated git-hook runner; the editable hook itself is committed.
.vite-hooks/_/
