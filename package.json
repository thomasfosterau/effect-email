{
  "$schema": "https://www.schemastore.org/package",
  "name": "effect-connect-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace for @thomasfosterau/effect-connect and its providers (SendGrid, Resend, Twilio): an Effect-native messaging abstraction over email and SMS.",
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "changeset": "changeset",
    "version": "changeset version && vp fmt && pnpm install --lockfile-only",
    "release": "bash scripts/release.sh",
    "fallow": "fallow --summary",
    "fallow:audit": "fallow audit --base origin/trunk",
    "prepare": "vp config && effect-tsgo patch --typescript --oxlint"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@effect/docgen": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/tsgo": "catalog:",
    "@mpsuesser/oxlint-plugin-effect": "catalog:",
    "@thomasfosterau/effect-connect": "workspace:*",
    "@thomasfosterau/effect-connect-resend": "workspace:*",
    "@thomasfosterau/effect-connect-sendgrid": "workspace:*",
    "@thomasfosterau/effect-connect-twilio": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "effect": "catalog:",
    "fallow": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.18.0"
}
