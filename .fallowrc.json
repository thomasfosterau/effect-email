{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "packages/core/src/index.ts",
    "packages/resend/src/index.ts",
    "packages/alchemy/src/index.ts",
    "packages/*/tests/**/*.test.ts",
    "tests/dist-consumer/src/*.ts",
    "**/vite.config.ts",
    "vite.package.ts"
  ],
  "ignorePatterns": ["**/dist/**", "**/coverage/**", "packages/*/docs/**"],
  "ignoreDependencies": [
    "@thomasfosterau/effect-connect",
    "@thomasfosterau/effect-connect-resend",
    "@thomasfosterau/effect-connect-alchemy",
    "@types/node",
    "@effect/tsgo",
    "@effect/language-service",
    "@typescript/native",
    "typescript",
    "vite",
    "vitest",
    "vite-plus",
    "@changesets/cli",
    "@changesets/changelog-github",
    "@effect/docgen",
    "tsx",
    "@vitest/coverage-istanbul",
    "fallow"
  ],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "warn",
    "unused-enum-members": "error",
    "unused-class-members": "warn",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "duplicate-exports": "error",
    "circular-dependencies": "error",
    "boundary-violation": "error",
    "stale-suppressions": "warn"
  },
  "boundaries": {
    "zones": [
      {
        "name": "core",
        "patterns": ["packages/core/**"]
      },
      {
        "name": "resend",
        "patterns": ["packages/resend/**"]
      },
      {
        "name": "alchemy",
        "patterns": ["packages/alchemy/src/**"]
      },
      {
        "name": "alchemy-tests",
        "patterns": ["packages/alchemy/tests/**"]
      },
      {
        "name": "dist-consumer",
        "patterns": ["tests/dist-consumer/**"]
      }
    ],
    "rules": [
      {
        "from": "core",
        "allow": []
      },
      {
        "from": "resend",
        "allow": ["core"]
      },
      {
        "from": "alchemy",
        "allow": []
      },
      {
        "from": "alchemy-tests",
        "allow": ["alchemy", "resend"]
      },
      {
        "from": "dist-consumer",
        "allow": ["core", "resend", "alchemy"]
      }
    ]
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "coverage": "coverage/coverage-final.json"
  }
}
