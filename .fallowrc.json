{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "packages/core/src/index.ts",
    "packages/sendgrid/src/index.ts",
    "packages/resend/src/index.ts",
    "packages/twilio/src/index.ts",
    "packages/vonage/src/index.ts",
    "packages/slack/src/index.ts",
    "packages/discord/src/index.ts",
    "packages/alchemy/src/index.ts",
    "packages/*/tests/**/*.test.ts",
    "tests/dist-consumer/src/*.ts",
    "**/vite.config.ts",
    "vite.package.ts"
  ],
  "ignorePatterns": ["**/dist/**", "**/coverage/**", "packages/*/docs/**"],
  "ignoreDependencies": [
    "@thomasfosterau/effect-connect",
    "@thomasfosterau/effect-connect-resend",
    "@thomasfosterau/effect-connect-sendgrid",
    "@thomasfosterau/effect-connect-twilio",
    "@thomasfosterau/effect-connect-vonage",
    "@thomasfosterau/effect-connect-slack",
    "@thomasfosterau/effect-connect-discord",
    "@thomasfosterau/effect-connect-alchemy",
    "@types/node",
    "@effect/tsgo",
    "@effect/language-service",
    "@typescript/native",
    "typescript",
    "vite",
    "vitest",
    "vite-plus",
    "@changesets/cli",
    "@changesets/changelog-github",
    "@effect/docgen",
    "tsx",
    "@vitest/coverage-istanbul",
    "fallow"
  ],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "warn",
    "unused-enum-members": "error",
    "unused-class-members": "warn",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "duplicate-exports": "error",
    "circular-dependencies": "error",
    "boundary-violation": "error",
    "stale-suppressions": "warn"
  },
  "boundaries": {
    "zones": [
      {
        "name": "core",
        "patterns": ["packages/core/**"]
      },
      {
        "name": "sendgrid",
        "patterns": ["packages/sendgrid/**"]
      },
      {
        "name": "resend",
        "patterns": ["packages/resend/**"]
      },
      {
        "name": "twilio",
        "patterns": ["packages/twilio/**"]
      },
      {
        "name": "vonage",
        "patterns": ["packages/vonage/**"]
      },
      {
        "name": "slack",
        "patterns": ["packages/slack/**"]
      },
      {
        "name": "discord",
        "patterns": ["packages/discord/**"]
      },
      {
        "name": "alchemy",
        "patterns": ["packages/alchemy/src/**"]
      },
      {
        "name": "alchemy-tests",
        "patterns": ["packages/alchemy/tests/**"]
      },
      {
        "name": "dist-consumer",
        "patterns": ["tests/dist-consumer/**"]
      }
    ],
    "rules": [
      {
        "from": "core",
        "allow": []
      },
      {
        "from": "sendgrid",
        "allow": ["core"]
      },
      {
        "from": "resend",
        "allow": ["core"]
      },
      {
        "from": "twilio",
        "allow": ["core"]
      },
      {
        "from": "vonage",
        "allow": ["core"]
      },
      {
        "from": "slack",
        "allow": ["core"]
      },
      {
        "from": "discord",
        "allow": ["core"]
      },
      {
        "from": "alchemy",
        "allow": []
      },
      {
        "from": "alchemy-tests",
        "allow": ["alchemy", "sendgrid", "resend", "twilio", "vonage", "slack", "discord"]
      },
      {
        "from": "dist-consumer",
        "allow": ["core", "sendgrid", "resend", "twilio", "vonage", "slack", "discord", "alchemy"]
      }
    ]
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "coverage": "coverage/coverage-final.json"
  }
}
